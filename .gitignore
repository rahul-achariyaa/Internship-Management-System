.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
error_log
access_log

# Temporary Files
*.tmp
*.temp
*.cache

# Backup Files
*.bak
*.backup
*~

# PHP
*.php~
vendor/
composer.lock

# Database Dumps (optional)
*.sql.gz
*.sql.zip
backup/

# Environment Files (if using)
.env
.env.local

# Session Files
sessions/

# Cache
cache/
*.cache

# Node Modules (if using frontend build tools)
node_modules/
npm-debug.log
yarn-error.log

# Build Files
dist/
build/

# Documentation Build
docs/_build/

# Coverage Reports
coverage/

# Test Files
tests/coverage/

